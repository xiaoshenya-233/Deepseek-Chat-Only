diff --git a/build-windows.ps1 b/build-windows.ps1
new file mode 100644
index 0000000..2ab21af
--- /dev/null
+++ b/build-windows.ps1
@@ -0,0 +1,95 @@
+﻿# Build the official chat-demo source (web/) and publish the output to release/web,
+# where android/build-apk.ps1, ios/stage-web.ps1 and desktop/prepare-web.ps1
+# pick it up. The repository root stays free of generated files.
+#
+# release/ 是唯一的成品目录，按平台分子目录：
+#   release/web/      index.html + static/ + LICENSE / NOTICE / LICENSES/
+#   release/android/  *.apk
+#   release/desktop/  *.exe / *.zip / *.deb
+#   release/ios/      *.ipa
+#
+# Requirements: Node 22+, pnpm, and web/node_modules (pnpm install).
+# Usage: powershell -NoProfile -ExecutionPolicy Bypass -File web\build-windows.ps1
+param(
+    [string]$Web = $PSScriptRoot,
+    [switch]$SkipNativeShim
+)
+
+$ErrorActionPreference = "Stop"
+$root = Resolve-Path (Join-Path $Web "..")
+$release = Join-Path $root "release"
+# 网页成品放在 release\web，其它平台目录（android / desktop / ios）互不影响
+$webOut = Join-Path $release "web"
+
+Push-Location $Web
+try {
+    Write-Host "==> Building web app (NODE_ENV=production)"
+    # Upstream's npm script relies on `rm -rf`, which Windows shells lack;
+    # rspack already cleans dist because output.clean is enabled.
+    $env:NODE_ENV = "production"
+    & pnpm exec rspack build -c rspack.config.ts
+    if ($LASTEXITCODE -ne 0) { throw "rspack build failed" }
+} finally {
+    Pop-Location
+}
+
+$dist = Join-Path $Web "dist"
+$distIndex = Join-Path $dist "index.html"
+if (-not (Test-Path $distIndex)) { throw "Build output is missing dist/index.html" }
+$mainBundle = Get-ChildItem (Join-Path $dist "static\js") -Filter "main.*.js" -File |
+    Select-Object -First 1
+if (-not $mainBundle) { throw "Build output is missing static/js/main.*.js" }
+
+Write-Host "==> Publishing to release/web/"
+# 只重建 release\web：整个 release\ 里还有 android\desktop\ios 的成品，不能一起删。
+if (Test-Path -LiteralPath $webOut) { Remove-Item -LiteralPath $webOut -Recurse -Force }
+# 顺手清掉旧布局（成品曾直接放在 release\ 根下）
+foreach ($legacy in @("index.html", "static", "LICENSE")) {
+    $stale = Join-Path $release $legacy
+    if (Test-Path -LiteralPath $stale) { Remove-Item -LiteralPath $stale -Recurse -Force }
+}
+New-Item -ItemType Directory -Force -Path $webOut | Out-Null
+Copy-Item -LiteralPath (Join-Path $dist "static") -Destination $webOut -Recurse -Force
+Copy-Item -LiteralPath $distIndex -Destination (Join-Path $webOut "index.html") -Force
+# 许可随产物分发：产物根目录放 GPLv3 LICENSE 与 NOTICE，
+# 上游 chat-demo 的 MIT 原文放在 LICENSES/ 里（MIT 要求再分发时保留，不能省）。
+Copy-Item -LiteralPath (Join-Path $root "LICENSE") -Destination (Join-Path $webOut "LICENSE") -Force
+Copy-Item -LiteralPath (Join-Path $root "NOTICE") -Destination (Join-Path $webOut "NOTICE") -Force
+$mitText = Join-Path $root "LICENSES\MIT-deepseek-chat-demo.txt"
+if (Test-Path -LiteralPath $mitText) {
+    $mitDir = Join-Path $webOut "LICENSES"
+    New-Item -ItemType Directory -Force -Path $mitDir | Out-Null
+    Copy-Item -LiteralPath $mitText -Destination $mitDir -Force
+}
+
+$indexPath = Join-Path $webOut "index.html"
+$html = [System.IO.File]::ReadAllText($indexPath)
+
+# Keep the download bridge outside of the web source until it is ported into
+# src/services/chat/backup.ts; it must load before the main bundle.
+if (-not $SkipNativeShim) {
+    $shimSource = Join-Path $root "native\download-bridge.js"
+    if (-not (Test-Path $shimSource)) { throw "Missing native\download-bridge.js" }
+    $shimDir = Join-Path $webOut "static\js"
+    if (-not (Test-Path -LiteralPath $shimDir)) { New-Item -ItemType Directory -Force -Path $shimDir | Out-Null }
+    Copy-Item -LiteralPath $shimSource -Destination (Join-Path $shimDir "download-bridge.js") -Force
+    if ($html -notmatch "static/js/download-bridge\.js") {
+        $anchor = [regex]::Match($html, '<script defer src="static/js/main\.[^"]+\.js"></script>')
+        if (-not $anchor.Success) { throw "Unable to locate the main bundle script tag" }
+        $html = $html.Insert($anchor.Index,
+            '<script defer src="static/js/download-bridge.js"></script>')
+        [System.IO.File]::WriteAllText($indexPath, $html, (New-Object System.Text.UTF8Encoding($false)))
+        Write-Host "    download bridge injected into release/web/index.html"
+    } else {
+        Write-Host "    download bridge already present in release/web/index.html"
+    }
+}
+
+$releaseStatic = Join-Path $webOut "static"
+$asyncCount = (Get-ChildItem (Join-Path $releaseStatic "js\async") -File).Count
+$total = (Get-ChildItem $releaseStatic -Recurse -File).Count
+Write-Host ("    release/web/static: {0} files ({1} async chunks), main bundle {2} ({3:N0} bytes)" -f `
+        $total, $asyncCount, $mainBundle.Name, $mainBundle.Length)
+Write-Host ("    published: {0}" -f $webOut)
+Write-Host ""
+Write-Host "Next: powershell -NoProfile -ExecutionPolicy Bypass -File android\build-apk.ps1"
diff --git a/check-upstream.ps1 b/check-upstream.ps1
new file mode 100644
index 0000000..31d6375
--- /dev/null
+++ b/check-upstream.ps1
@@ -0,0 +1,150 @@
+﻿<#
+.SYNOPSIS
+  Read-only upstream drift check for https://github.com/deepseek-ai/chat-demo
+
+.DESCRIPTION
+  Runs `git fetch` (updates remote refs only, never touches the work tree or branch),
+  then reports new commits / new tags / changed files against the pinned baseline tag,
+  and flags two risk classes:
+    * capability areas changed (src/services, src/app, src/utils, src/main.tsx)
+    * files that also carry local patches -> must be replayed by hand
+
+  This script NEVER merges, rebases or checks out anything.
+
+.EXAMPLE
+  powershell -NoProfile -ExecutionPolicy Bypass -File web\check-upstream.ps1
+
+.EXAMPLE
+  powershell -NoProfile -ExecutionPolicy Bypass -File web\check-upstream.ps1 -OutFile ..\docs\upstream-report.md
+#>
+[CmdletBinding()]
+param(
+    [string]$Base = 'v0.1.3',
+    [string]$Remote = 'origin',
+    [string]$OutFile
+)
+
+$ErrorActionPreference = 'Stop'
+$repo = $PSScriptRoot
+$report = New-Object System.Collections.Generic.List[string]
+
+function Add-Line([string]$text) {
+    $script:report.Add($text) | Out-Null
+    Write-Host $text
+}
+
+Push-Location $repo
+try {
+    $env:GIT_TERMINAL_PROMPT = '0'
+
+    git fetch --tags --prune $Remote 2>&1 | ForEach-Object { Write-Host $_ }
+    if ($LASTEXITCODE -ne 0) { throw "git fetch failed (network / proxy?)" }
+
+    $defaultRef = "$Remote/main"
+    git rev-parse --verify --quiet $defaultRef | Out-Null
+    if ($LASTEXITCODE -ne 0) { throw "remote branch $defaultRef not found; adjust -Remote or the branch name" }
+
+    $baseCommit = (git rev-parse "$Base^{commit}").Trim()
+    $headCommit = (git rev-parse $defaultRef).Trim()
+    $range = "$baseCommit..$headCommit"
+    $count = [int]((git rev-list --count $range).Trim())
+
+    Add-Line '# Upstream drift report (chat-demo)'
+    Add-Line ''
+    Add-Line ("generated  : " + (Get-Date -Format 'yyyy-MM-dd HH:mm'))
+    Add-Line ("repo       : " + $repo)
+    Add-Line ("baseline   : $Base (" + $baseCommit.Substring(0, 7) + ")")
+    Add-Line ("remote     : $defaultRef (" + $headCommit.Substring(0, 7) + ")")
+    Add-Line ("new commits: $count")
+    Add-Line ''
+
+    if ($count -eq 0) {
+        Add-Line 'VERDICT: baseline is up to date, nothing to sync.'
+    }
+    else {
+        Add-Line '## New commits'
+        Add-Line '```text'
+        git --no-pager log --no-decorate --date=short --format='%h %ad %s' $range | ForEach-Object { Add-Line $_ }
+        Add-Line '```'
+        Add-Line ''
+
+        # tags not reachable from the baseline yet
+        $newTags = @()
+        foreach ($t in @(git tag --sort=creatordate)) {
+            git merge-base --is-ancestor $t $baseCommit 2>$null
+            if ($LASTEXITCODE -ne 0) { $newTags += $t }
+        }
+        Add-Line '## New tags'
+        if ($newTags.Count -eq 0) { Add-Line '(none)' } else { $newTags | ForEach-Object { Add-Line ('- ' + $_) } }
+        Add-Line ''
+
+        $changed = @(git --no-pager diff --name-only $range)
+        $capability = @($changed | Where-Object { $_ -match '^src/(services|app|utils)/' -or $_ -match '^src/main\.tsx$' })
+        $ui = @($changed | Where-Object { $_ -match '^src/components/' })
+        $i18n = @($changed | Where-Object { $_ -match '^src/i18n/' })
+        $style = @($changed | Where-Object { $_ -match '\.css$' })
+        $dep = @($changed | Where-Object { $_ -match '^(package\.json|pnpm-lock\.yaml|rspack|tsconfig|\.npmrc)' })
+
+        Add-Line '## Changed files by area'
+        Add-Line ''
+        Add-Line ('capability (src/services|app|utils, main.tsx): ' + $capability.Count)
+        Add-Line ('ui         (src/components)              : ' + $ui.Count)
+        Add-Line ('i18n       (src/i18n)                    : ' + $i18n.Count)
+        Add-Line ('style      (*.css)                       : ' + $style.Count)
+        Add-Line ('build/deps (package.json, rspack, ts..)  : ' + $dep.Count)
+        Add-Line ''
+        if ($capability.Count -gt 0) {
+            Add-Line '### capability files'
+            $capability | ForEach-Object { Add-Line ('- ' + $_) }
+            Add-Line ''
+        }
+
+        # files that also carry local patches
+        $localPatched = @(git --no-pager diff --name-only)
+        $localUntracked = @(git ls-files --others --exclude-standard)
+        $conflicts = @($changed | Where-Object { $localPatched -contains $_ })
+        Add-Line '## Local patch overlap'
+        Add-Line ''
+        if ($localPatched.Count) { Add-Line ('local modified : ' + ($localPatched -join ', ')) } else { Add-Line 'local modified : (none)' }
+        if ($localUntracked.Count) { Add-Line ('local untracked: ' + ($localUntracked -join ', ')) } else { Add-Line 'local untracked: (none)' }
+        Add-Line ''
+        if ($conflicts.Count -gt 0) {
+            Add-Line 'CONFLICT: changed upstream AND patched locally (replay by hand):'
+            $conflicts | ForEach-Object { Add-Line ('- ' + $_) }
+        }
+        else {
+            Add-Line 'No overlap with local patches.'
+        }
+        Add-Line ''
+
+        Add-Line '## Verdict'
+        if ($capability.Count -gt 0) {
+            Add-Line 'WARNING: capability layer changed -> compare each item against'
+            Add-Line '         docs/upstream-sync.md (feature inventory) BEFORE merging;'
+            Add-Line '         report any feature loss / behaviour change.'
+        }
+        elseif ($conflicts.Count -gt 0) {
+            Add-Line 'INFO: UI/copy only, but local patches need replay (see conflicts above).'
+        }
+        else {
+            Add-Line 'INFO: low risk (no capability files touched).'
+        }
+        Add-Line ''
+        Add-Line 'Next: fill the comparison table, ask the user, then merge and replay patches.'
+    }
+
+    if ($OutFile) {
+        $target = $OutFile
+        if (-not [System.IO.Path]::IsPathRooted($target)) { $target = Join-Path $repo $target }
+        $target = [System.IO.Path]::GetFullPath($target)
+        $dir = Split-Path -Parent $target
+        if ($dir -and -not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
+        $utf8NoBom = New-Object System.Text.UTF8Encoding($false)
+        [System.IO.File]::WriteAllText($target, ($report -join "`r`n"), $utf8NoBom)
+        Write-Host ''
+        Write-Host ('report written: ' + $target)
+    }
+}
+finally {
+    Pop-Location
+}
