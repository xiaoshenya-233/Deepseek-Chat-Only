diff --git a/src/components/backup/BackupProgressBar.module.css b/src/components/backup/BackupProgressBar.module.css
new file mode 100644
index 0000000..d9c041b
--- /dev/null
+++ b/src/components/backup/BackupProgressBar.module.css
@@ -0,0 +1,110 @@
+.wrap {
+  position: fixed;
+  left: 50%;
+  bottom: max(24px, env(safe-area-inset-bottom));
+  z-index: 1500;
+  width: min(380px, calc(100vw - 32px));
+  transform: translateX(-50%);
+  pointer-events: none;
+
+  /* 移动端输入框较高，进度条上移避免遮挡发送按钮 */
+  @media not all and (min-width: 768px) {
+    bottom: calc(96px + env(safe-area-inset-bottom));
+  }
+}
+
+.card {
+  box-sizing: border-box;
+  padding: 14px 16px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 14px;
+  color: var(--dsw-alias-label-primary);
+  background-color: var(--dsw-alias-bg-layer-2);
+  box-shadow:
+    0 0 1px 0 rgba(0, 0, 0, 0.2),
+    0 8px 28px 0 rgba(0, 0, 0, 0.16);
+  pointer-events: auto;
+}
+
+.failed {
+  border-color: var(--dsw-alias-state-error-primary);
