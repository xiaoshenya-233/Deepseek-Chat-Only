diff --git a/src/services/chat/activity.ts b/src/services/chat/activity.ts
new file mode 100644
index 0000000..0526c15
--- /dev/null
+++ b/src/services/chat/activity.ts
@@ -0,0 +1,107 @@
+import { create } from 'zustand'
+
+/**
+ * 休闲模式主页的「活跃度」与「隐藏」记录：
+ * - activity：真正发过消息的会话（导入但没聊过的不算），最近使用的排在最前；
+ * - hidden：用户从聊天主页移除的会话，数据仍保留，在「会话」里再发一条消息就会回到主页。
+ * 全部存 localStorage，跟置顶、提示词保持一致（不进官方导出 ZIP）。
+ */
+const ACTIVITY_KEY = 'chat-demo:session-activity'
+const HIDDEN_KEY = 'chat-demo:casual-hidden'
+/** 主页「常用会话」不需要太多历史，超过就丢弃最久未用的 */
+const MAX_ACTIVITY = 30
+
+const readList = (key: string): string[] => {
+  try {
+    const raw = localStorage.getItem(key)
+    if (!raw) {
+      return []
+    }
+    const parsed: unknown = JSON.parse(raw)
+    if (!Array.isArray(parsed)) {
+      return []
+    }
+    return parsed.filter((id): id is string => typeof id === 'string' && id.length > 0)
+  } catch {
+    return []
+  }
+}
+
+const writeList = (key: string, value: string[]) => {
+  try {
+    if (value.length === 0) {
+      localStorage.removeItem(key)
+    } else {
+      localStorage.setItem(key, JSON.stringify(value))
+    }
+  } catch {
+    // 隐私模式下写入失败时仍保留内存里的值
+  }
+}
+
+export const useCasualSessions = create<{ activity: string[]; hidden: string[] }>(() => ({
+  activity: readList(ACTIVITY_KEY),
+  hidden: readList(HIDDEN_KEY),
+}))
+
+const setActivity = (activity: string[]) => {
+  writeList(ACTIVITY_KEY, activity)
+  useCasualSessions.setState({ activity })
+}
+
+const setHidden = (hidden: string[]) => {
+  writeList(HIDDEN_KEY, hidden)
+  useCasualSessions.setState({ hidden })
+}
+
+/** 发消息/重新生成/续写时调用：进入「常用」，并从隐藏名单里恢复 */
+export const markSessionActive = (sessionId: string) => {
+  const { activity, hidden } = useCasualSessions.getState()
+  setActivity([sessionId, ...activity.filter((id) => id !== sessionId)].slice(0, MAX_ACTIVITY))
+  if (hidden.includes(sessionId)) {
+    setHidden(hidden.filter((id) => id !== sessionId))
+  }
+}
+
+/** 只从聊天主页移除，不删除任何消息与附件 */
+export const hideFromCasualHome = (sessionId: string) => {
+  const { hidden } = useCasualSessions.getState()
+  if (!hidden.includes(sessionId)) {
+    setHidden([sessionId, ...hidden])
+  }
+}
+
+/**
+ * 把会话加入聊天主页（常用会话）。
+ * 同时用于：隐藏过的会话恢复、导入后没聊过的会话手动上首页。
+ */
+export const addToCasualHome = (sessionId: string) => {
+  markSessionActive(sessionId)
+}
+
+/** 会话当前是否显示在聊天主页（在常用名单里且没有被移除） */
+export const isOnCasualHome = (sessionId: string) => {
+  const { activity, hidden } = useCasualSessions.getState()
+  return activity.includes(sessionId) && !hidden.includes(sessionId)
+}
+
+export const restoreToCasualHome = (sessionId: string) => {
+  const { hidden } = useCasualSessions.getState()
+  if (hidden.includes(sessionId)) {
+    setHidden(hidden.filter((id) => id !== sessionId))
+  }
+}
+
+/** 删除会话时清掉对应记录 */
+export const forgetCasualSessions = (ids: string[]) => {
+  const removed = new Set(ids)
+  const { activity, hidden } = useCasualSessions.getState()
+  const nextActivity = activity.filter((id) => !removed.has(id))
+  const nextHidden = hidden.filter((id) => !removed.has(id))
+  if (nextActivity.length !== activity.length) {
+    setActivity(nextActivity)
+  }
+  if (nextHidden.length !== hidden.length) {
+    setHidden(nextHidden)
+  }
+}
diff --git a/src/services/chat/assets.ts b/src/services/chat/assets.ts
new file mode 100644
index 0000000..7c50f3c
--- /dev/null
+++ b/src/services/chat/assets.ts
@@ -0,0 +1,112 @@
+import { create } from 'zustand'
+import { compressImageForStorage } from '../../utils/compressImage.js'
+import { createId } from '../../utils/id.js'
+import * as db from './db.js'
+
+/**
+ * 会话头像与表情包：图片统一先过 `compressImageForStorage`（长边 2560 / 1.2 MiB 预算），
+ * 原件存 IndexedDB，界面用 object URL 展示；URL 在替换/删除时释放。
+ */
+export const useSessionAvatars = create<{ urls: Record<string, string>; ready: boolean }>(() => ({
+  urls: {},
+  ready: false,
+}))
+
+export type Sticker = {
+  id: string
+  blob: Blob
+  url: string
+  createdAt: number
+}
+
+export const useStickers = create<{ items: Sticker[]; ready: boolean }>(() => ({
+  items: [],
+  ready: false,
+}))
+
+let avatarInit: Promise<void> | null = null
+let stickerInit: Promise<void> | null = null
+
+export const initSessionAvatars = () =>
+  (avatarInit ??= (async () => {
+    try {
+      const records = await db.loadSessionAvatars()
+      const urls: Record<string, string> = {}
+      for (const record of records) {
+        urls[record.id] = URL.createObjectURL(record.blob)
+      }
+      useSessionAvatars.setState({ urls, ready: true })
+    } catch {
+      useSessionAvatars.setState({ ready: true })
+    }
+  })())
+
+export const initStickers = () =>
+  (stickerInit ??= (async () => {
+    try {
+      const records = await db.loadStickers()
+      useStickers.setState({
+        items: records.map((record) => ({
+          id: record.id,
+          blob: record.blob,
+          url: URL.createObjectURL(record.blob),
+          createdAt: record.createdAt,
+        })),
+        ready: true,
+      })
+    } catch {
+      useStickers.setState({ ready: true })
+    }
+  })())
+
+/** 设置会话头像：压缩后落库，并替换界面上的 object URL */
+export const setSessionAvatar = async (sessionId: string, file: File): Promise<void> => {
+  const compressed = await compressImageForStorage(file).catch(() => file)
+  await db.saveSessionAvatar(sessionId, compressed)
+  const urls = { ...useSessionAvatars.getState().urls }
+  const previous = urls[sessionId]
+  urls[sessionId] = URL.createObjectURL(compressed)
+  useSessionAvatars.setState({ urls })
+  if (previous) {
+    URL.revokeObjectURL(previous)
+  }
+}
+
+export const clearSessionAvatar = async (sessionId: string): Promise<void> => {
+  await db.deleteSessionAvatar(sessionId)
+  const current = useSessionAvatars.getState().urls
+  const previous = current[sessionId]
+  useSessionAvatars.setState({
+    urls: Object.fromEntries(Object.entries(current).filter(([id]) => id !== sessionId)),
+  })
+  if (previous) {
+    URL.revokeObjectURL(previous)
+  }
+}
+
+/** 新增表情包：图片自动压缩后保存 */
+export const addSticker = async (file: File): Promise<Sticker> => {
+  const compressed = await compressImageForStorage(file).catch(() => file)
+  const record: db.StickerRecord = {
+    id: createId(),
+    blob: compressed,
+    createdAt: Date.now(),
+  }
+  await db.saveSticker(record)
+  const sticker: Sticker = {
+    ...record,
+    url: URL.createObjectURL(compressed),
+  }
+  useStickers.setState((state) => ({ items: [sticker, ...state.items] }))
+  return sticker
+}
+
+export const removeSticker = async (id: string): Promise<void> => {
+  await db.deleteSticker(id)
+  const items = useStickers.getState().items
+  const target = items.find((item) => item.id === id)
+  useStickers.setState({ items: items.filter((item) => item.id !== id) })
+  if (target) {
+    URL.revokeObjectURL(target.url)
+  }
+}
