+    border-color 0.2s,
+    transform 0.2s,
+    box-shadow 0.2s;
+  animation: jumpIn 0.16s ease-out;
+
+  &:hover {
+    color: var(--dsw-alias-label-primary);
+    border-color: var(--dsw-alias-border-l2);
+    transform: translateY(-1px);
+  }
+
+  &:active {
+    transform: scale(0.94);
+  }
+
+  &:focus-visible {
+    outline: 2px solid var(--dsw-alias-brand-primary);
+    outline-offset: 2px;
+  }
+}
+
+.jumpDot {
+  position: absolute;
+  right: 5px;
+  bottom: 5px;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--dsw-alias-brand-primary);
+  animation: jumpPulse 1.4s ease-in-out infinite;
+}
+
+@keyframes jumpIn {
+  from {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+}
+
+@keyframes jumpPulse {
+  0%,
+  100% {
+    opacity: 1;
+    transform: scale(1);
+  }
+  50% {
+    opacity: 0.55;
+    transform: scale(0.82);
+  }
+}
+
+/* 会话总览跳转后的短暂高亮：让人一眼看到落点 */
+.listArea [data-dsc-jump='1'] {
+  border-radius: 12px;
+  animation: jumpFlash 1.4s ease-out;
+}
+
+@keyframes jumpFlash {
+  0%,
