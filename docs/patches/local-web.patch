+
+/**
+ * 版本号的唯一来源是仓库根的 VERSION（格式 x.xxx.xx），不再读 web/package.json。
+ * 后者保留上游自己的版本号（v0.1.3），只用来标识上游基线，不代表本仓库的发布版本。
+ */
+const version = (() => {
+  const file = new URL('../VERSION', import.meta.url)
+  let value = ''
+  try {
+    value = readFileSync(file, 'utf8').trim()
+  } catch {
+    throw new Error(`缺少版本文件 ${file.pathname}：VERSION 是唯一版本来源（格式 x.xxx.xx）`)
+  }
+  if (!/^\d+\.\d+\.\d+$/.test(value)) {
+    throw new Error(`VERSION 格式非法："${value}"，应为 x.xxx.xx`)
+  }
+  return value
+})()
 
