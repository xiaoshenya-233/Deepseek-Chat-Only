+}
+
+/** 右侧预览面板要展示的最新一条消息（正文不截断，图片等只有类型） */
+export type LatestMessageView = {
+  role: 'user' | 'assistant'
+  /** 正文；只有附件时为 empty string */
+  text: string
+  preview: SessionPreview | null
