+  100% {
+    background-color: transparent;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .jumpButton,
+  .jumpDot,
+  .listArea [data-dsc-jump='1'] {
+    animation: none;
+  }
+}
+
+@media not all and (min-width: 768px) {
