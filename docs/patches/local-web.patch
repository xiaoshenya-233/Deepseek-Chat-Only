+/*
+ * 回到底部：浮在输入框正上方、水平居中，不随消息滚动，也不遮挡发送按钮。
+ * 生成中在图标右下角放一个脉冲点，提示「下面还有新内容」。
+ */
+.jumpButton {
+  position: absolute;
+  left: 50%;
+  bottom: calc(var(--dsc-composer-height, 120px) + 12px);
+  z-index: 12;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 36px;
+  height: 36px;
+  margin-left: -18px;
+  padding: 0;
+  border: 1px solid var(--dsw-alias-border-l1);
+  border-radius: 50%;
+  color: var(--dsw-alias-label-secondary);
+  background: var(--dsw-alias-bg-base);
+  box-shadow: 0 2px 10px rgb(0 0 0 / 12%);
+  cursor: pointer;
+  transition:
