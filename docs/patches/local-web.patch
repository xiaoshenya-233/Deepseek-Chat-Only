@@ -0,0 +1,62 @@
+import clsx from 'clsx'
+import { useTranslate } from '../../i18n/index.js'
+import { requestCancelBackup, useBackupProgress } from './backupProgressState.js'
+import styles from './BackupProgressBar.module.css'
+
+/**
+ * 导入/导出的进度条：固定在窗口底部居中，关闭设置弹窗后仍然可见。
+ * 进行中可取消（在下一个归档条目边界停止，原有数据不变）。
+ */
+export const BackupProgressBar = () => {
+  const t = useTranslate()
+  const open = useBackupProgress((state) => state.open)
+  const titleKey = useBackupProgress((state) => state.titleKey)
+  const label = useBackupProgress((state) => state.label)
+  const percent = useBackupProgress((state) => state.percent)
+  const outcome = useBackupProgress((state) => state.outcome)
+  const cancelling = useBackupProgress((state) => state.cancelling)
+  if (!open) {
+    return null
+  }
+  const failed = outcome === 'error'
+  const title =
+    outcome === 'done'
+      ? `${t(titleKey)} · ${t('backupProgressDone')}`
+      : failed
+        ? t('backupProgressFailed')
+        : outcome === 'cancelled'
+          ? `${t(titleKey)} · ${t('backupProgressCancelled')}`
+          : t(titleKey)
+  return (
+    <div className={styles.wrap}>
+      <div className={clsx(styles.card, failed && styles.failed)} role="status" aria-live="polite">
+        <div className={styles.head}>
+          <span className={styles.title}>{title}</span>
+          {outcome === 'running' ? (
+            <button
+              type="button"
+              className={styles.cancel}
+              disabled={cancelling}
+              onClick={requestCancelBackup}
+            >
+              {cancelling ? t('backupProgressCancelled') : t('backupProgressCancel')}
+            </button>
+          ) : null}
+        </div>
+        <div
+          className={styles.track}
+          role="progressbar"
+          aria-valuemin={0}
+          aria-valuemax={100}
+          aria-valuenow={percent}
+        >
+          <div className={styles.bar} style={{ width: `${percent}%` }} />
+        </div>
+        <div className={styles.meta}>
+          <span>{t(label.key, label.params)}</span>
+          <span>{percent}%</span>
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/src/components/backup/backupProgressState.ts b/src/components/backup/backupProgressState.ts
new file mode 100644
index 0000000..72d363f
--- /dev/null
+++ b/src/components/backup/backupProgressState.ts
@@ -0,0 +1,88 @@
+import { create } from 'zustand'
+import type { TranslationKey } from '../../i18n/index.js'
+
+type BackupOutcome = 'running' | 'done' | 'error' | 'cancelled'
+
+type Label = { key: TranslationKey; params?: Record<string, number> }
+
+type State = {
+  open: boolean
+  titleKey: TranslationKey
+  label: Label
+  percent: number
+  outcome: BackupOutcome
+  /** 已请求取消，等待当前读写步骤结束 */
+  cancelling: boolean
+}
+
+const IDLE: State = {
+  open: false,
+  titleKey: 'backupProgressImporting',
+  label: { key: 'backupProgressChecking' },
+  percent: 0,
+  outcome: 'running',
+  cancelling: false,
+}
+
+export const useBackupProgress = create<State>(() => IDLE)
+
+/** 当前任务的取消回调；导入时由 AbortController 提供 */
+let cancelHandler: (() => void) | null = null
+let hideTimer: ReturnType<typeof setTimeout> | null = null
+
+const clearHide = () => {
+  if (hideTimer !== null) {
+    clearTimeout(hideTimer)
+    hideTimer = null
+  }
+}
+
+/** 开始一次导入/导出：显示进度条并注册取消回调。 */
+export const beginBackupProgress = (
+  titleKey: TranslationKey,
+  onCancel?: () => void
+) => {
+  clearHide()
+  cancelHandler = onCancel ?? null
+  useBackupProgress.setState({
+    open: true,
+    titleKey,
+    label: { key: titleKey === 'backupProgressExporting' ? 'backupProgressExportReading' : 'backupProgressChecking' },
+    percent: 0,
+    outcome: 'running',
+    cancelling: false,
+  })
+}
+
+export const updateBackupProgress = (label: Label, percent: number) => {
+  const { outcome } = useBackupProgress.getState()
+  if (outcome !== 'running') {
+    return
+  }
+  useBackupProgress.setState({ label, percent: Math.max(0, Math.min(100, percent)) })
+}
+
+/** 结束进度条：完成后短暂停留再收起，失败与取消保留更久便于阅读。 */
+export const finishBackupProgress = (outcome: Exclude<BackupOutcome, 'running'>) => {
+  cancelHandler = null
+  useBackupProgress.setState({
+    outcome,
+    cancelling: false,
+    percent: outcome === 'done' ? 100 : useBackupProgress.getState().percent,
+    ...(outcome === 'done' ? { label: { key: 'backupProgressDone' } } : {}),
+  })
+  clearHide()
+  hideTimer = setTimeout(
+    () => useBackupProgress.setState(IDLE),
+    outcome === 'done' ? 900 : 2400
+  )
+}
+
+/** 点击取消：只发出信号，读写循环在下一个条目边界停止。 */
+export const requestCancelBackup = () => {
+  if (cancelHandler === null) {
+    return
+  }
+  useBackupProgress.setState({ cancelling: true })
+  cancelHandler()
+}
